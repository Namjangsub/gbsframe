<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="hrCriteria">

	<!-- 인사기준정보(TB_CM06D01) 조인: 사원별 근태/연차/휴가 대상 여부 및 귀속부서 검증 -->
	<sql id="targetJoin">
		LEFT OUTER JOIN TB_CM06D01 HRD ON HRD.ID = ${u}.ID
	</sql>

	<!-- 근태/연차/휴가 대상 필터: ATT_TARGET_YN = 'Y' (D01 행 없는 사원도 NVL로 기본값 'Y' 적용) -->
	<sql id="targetWhere">
		AND NVL(HRD.ATT_TARGET_YN, 'Y') = 'Y'
	</sql>

	<!-- 근태 전용 휴직 제외 필터: LOA_CD != 'CM06LOA00' (다음 Slice에서 사용) -->
	<sql id="activeWhere">
		AND NVL(HRD.LOA_CD, 'CM06LOA00') = 'CM06LOA00'
	</sql>

	<!-- 회사구분 필터: 선택 시 HR_CO_CD(없으면 CO_CD) 일치. 파라미터 hrCoCd -->
	<sql id="coWhere">
		<if test="hrCoCd != null and hrCoCd != ''">
			AND NVL(HRD.HR_CO_CD, ${u}.CO_CD) = #{hrCoCd, jdbcType=VARCHAR}
		</if>
	</sql>

</mapper>
